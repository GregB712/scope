# Scope environment variables.
# Copy to .env.local for local development. On Vercel, set the same names in
# Project Settings > Environment Variables. Never commit real values.

# --- Database (Neon PostgreSQL) ------------------------------------------------
# Pooled connection string (host contains "-pooler"). Used by the app at runtime.
# Neon console > your project > Connect > "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection string. Used only by `npm run db:migrate`.
# Optional: falls back to DATABASE_URL. The Vercel-Neon integration sets both names.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Authentication (Clerk) ----------------------------------------------------
# Clerk dashboard > your application > API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Where Clerk sends users to sign in or up. These defaults match the app's routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Google Drive (read-only service account) ----------------------------------
# Base64 of the service account's JSON key. See docs/google-drive-setup.md.
#   Linux/WSL: base64 -w0 key.json    macOS: base64 -i key.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_KEY=

# --- Scheduled synchronization -------------------------------------------------
# Random string of at least 16 characters. Vercel sends it to /api/cron/sync as
# "Authorization: Bearer <CRON_SECRET>". Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=
# Optional. Milliseconds a sync may spend importing before it stops and leaves the
# rest for the next run. Keep below the platform's function limit (300 s on Hobby).
# SYNC_TIME_BUDGET_MS=240000

# --- Local development only ----------------------------------------------------
# Lets a newsroom read Markdown from a local folder instead of Google Drive.
# Ignored when NODE_ENV=production. Paths are confined to FILESYSTEM_SOURCE_ROOT.
# ENABLE_FILESYSTEM_SOURCE=true
# FILESYSTEM_SOURCE_ROOT=./fixtures/reports
